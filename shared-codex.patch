diff --git a/apps/server/src/provider/sharedCodexTerminalRelay.ts b/apps/server/src/provider/sharedCodexTerminalRelay.ts
new file mode 100644
index 000000000..f5ee62f46
--- /dev/null
+++ b/apps/server/src/provider/sharedCodexTerminalRelay.ts
@@ -0,0 +1,120 @@
+// @effect-diagnostics nodeBuiltinImport:off - native CLI WebSocket boundary.
+import * as NodeFSP from "node:fs/promises";
+import * as NodeHttp from "node:http";
+import * as NodePath from "node:path";
+import { NodeWS } from "@effect/platform-node/NodeSocket";
+import { makeTerminalObserver, type TerminalObservation } from "./sharedCodexTerminalState.ts";
+
+export async function startTerminalRelay(options: {
+  upstreamSocket: string;
+  onState: (state: TerminalObservation | null) => void;
+  onError: (error: Error) => void;
+}) {
+  if (!options.upstreamSocket.startsWith("/") || /[:?#]/.test(options.upstreamSocket)) {
+    throw new Error("Expected an absolute native Unix socket path without URL delimiters.");
+  }
+  const directory = await NodeFSP.mkdtemp("/tmp/t3-codex-terminal-");
+  await NodeFSP.chmod(directory, 0o700);
+  const socketPath = NodePath.join(directory, "rpc.sock");
+  const http = NodeHttp.createServer();
+  const server = new NodeWS.WebSocketServer({ server: http, perMessageDeflate: false });
+  const peers = new Set<InstanceType<typeof NodeWS.WebSocket>>();
+  let owner: ReturnType<typeof makeTerminalObserver> | undefined;
+  server.on("connection", (terminal) => {
+    const observer = makeTerminalObserver();
+    let closing = false;
+    const native = new NodeWS.WebSocket(`ws+unix://${options.upstreamSocket}:/`, {
+      perMessageDeflate: false,
+      handshakeTimeout: 5000,
+    });
+    peers.add(terminal);
+    peers.add(native);
+    terminal.pause();
+    const close = () => {
+      if (closing) return;
+      closing = true;
+      observer.disconnect();
+      if (owner === observer) options.onState(observer.state());
+      peers.delete(terminal);
+      peers.delete(native);
+      terminal.terminate();
+      native.terminate();
+    };
+    for (const peer of [terminal, native]) {
+      peer.on("close", close);
+      peer.on("error", (error) => {
+        if (!closing) options.onError(error);
+        close();
+      });
+    }
+    function forward(
+      source: InstanceType<typeof NodeWS.WebSocket>,
+      target: InstanceType<typeof NodeWS.WebSocket>,
+      incoming: boolean,
+    ) {
+      source.on("message", (data, binary) => {
+        if (closing) return;
+        if (!binary) {
+          try {
+            const frame: unknown = JSON.parse(data.toString());
+            const previous = observer.state();
+            if (incoming) observer.receive(frame);
+            else observer.send(frame);
+            const current = observer.state();
+            if (current && current.nativeThreadId !== previous?.nativeThreadId) owner = observer;
+            if (owner === observer) options.onState(current);
+          } catch {
+            options.onError(new Error("Unable to observe native frame; forwarding it unchanged"));
+          }
+        }
+        source.pause();
+        target.send(data, { binary }, (error) => {
+          if (error) {
+            options.onError(error);
+            close();
+          } else if (!closing) source.resume();
+        });
+      });
+    }
+    forward(terminal, native, false);
+    forward(native, terminal, true);
+    native.once("open", () => {
+      if (!closing) terminal.resume();
+    });
+  });
+  try {
+    await new Promise<void>((resolve, reject) => {
+      http.once("error", reject);
+      http.listen(socketPath, resolve);
+    });
+    await NodeFSP.chmod(socketPath, 0o600);
+  } catch (error) {
+    server.close();
+    http.close();
+    await NodeFSP.rm(directory, { recursive: true, force: true });
+    throw error;
+  }
+  return {
+    socketPath,
+    async close() {
+      await Promise.all(
+        [...peers].map(
+          (peer) =>
+            new Promise<void>((resolve) => {
+              if (peer.readyState === NodeWS.WebSocket.CLOSED) {
+                resolve();
+                return;
+              }
+              peer.once("close", () => resolve());
+              peer.terminate();
+            }),
+        ),
+      );
+      server.close();
+      await new Promise<void>((resolve, reject) =>
+        http.close((error) => (error ? reject(error) : resolve())),
+      );
+      await NodeFSP.rm(directory, { recursive: true, force: true });
+    },
+  };
+}
