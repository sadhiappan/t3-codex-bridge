+// @effect-diagnostics nodeBuiltinImport:off globalTimers:off globalDate:off - Interactive Node launcher owns the child, diagnostic timestamps, and reporting heartbeat.
+import * as NodeChildProcess from "node:child_process";
+import * as NodeFS from "node:fs";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import * as NodeTimers from "node:timers";
+import { startTerminalRelay } from "./provider/sharedCodexTerminalRelay.ts";
+import { sharedLaunchArgs } from "./provider/sharedCodexLaunch.ts";
+import { registerSharedThread, unshareThread } from "./provider/sharedCodexRegistration.ts";
+import type { TerminalObservation } from "./provider/sharedCodexTerminalState.ts";
+
+const nativeBinary = process.env.T3_CODEX_BINARY ?? "codex";
+const originalArgs = process.argv.slice(2);
+if (originalArgs[0] === "unshare") {
+  const directory = process.env.T3_CODEX_SHARED_REGISTRATIONS;
+  if (!directory || originalArgs.length !== 2)
+    throw new Error("Usage: bridge codex unshare <session-id>");
+  await unshareThread(directory, originalArgs[1]!);
+  process.stdout.write(
+    "Sharing disabled. T3 will detach on its next discovery sweep; saved history is retained.\n",
+  );
+  process.exit(0);
+}
+const args = sharedLaunchArgs(originalArgs, process.cwd());
+if (!args || !process.stdin.isTTY || !process.stdout.isTTY) {
+  const result = NodeChildProcess.spawnSync(nativeBinary, originalArgs, { stdio: "inherit" });
+  if (result.error) throw result.error;
+  process.exit(result.status ?? 1);
+}
+const upstreamSocket = process.env.T3_CODEX_SHARED_SOCKET;
+if (!upstreamSocket)
+  throw new Error("T3_CODEX_SHARED_SOCKET must identify the native daemon socket.");
+const logDirectory = NodePath.join(NodeOS.homedir(), ".local", "state", "t3-codex-bridge");
+NodeFS.mkdirSync(logDirectory, { recursive: true, mode: 0o700 });
+const logPath = NodePath.join(logDirectory, "terminal.log");
+const logFd = NodeFS.openSync(logPath, "a", 0o600);
+let diagnosticCount = 0;
+function diagnostic(message: string) {
+  NodeFS.writeSync(
+    logFd,
+    JSON.stringify({ time: new Date().toISOString(), pid: process.pid, message }) + "\n",
+  );
+  diagnosticCount += 1;
+}
+const registrationDirectory = process.env.T3_CODEX_SHARED_REGISTRATIONS;
+const registrations = new Map<string, Promise<void>>();
+function register(state: TerminalObservation | null) {
+  if (!registrationDirectory || !state || registrations.has(state.nativeThreadId)) return;
+  const id = state.nativeThreadId;
+  registrations.set(
+    id,
+    registerSharedThread(registrationDirectory, id).catch((error) => {
+      registrations.delete(id);
+      diagnostic(`T3 session registration failed: ${String(error)}`);
+    }),
+  );
+}
+let latest: TerminalObservation | null = null;
+const relay = await startTerminalRelay({
+  upstreamSocket,
+  onState(state) {
+    register(state);
+    latest = state;
+  },
+  onError(error) {
+    diagnostic(`Shared Codex connection: ${error.message}`);
+  },
+});
+const heartbeat = NodeTimers.setInterval(() => {
+  register(latest);
+}, 2000);
+const child = NodeChildProcess.spawn(
+  nativeBinary,
+  ["--remote", "unix://" + relay.socketPath, "--no-alt-screen", ...args],
+  { stdio: "inherit" },
+);
+process.on("SIGTERM", () => child.kill("SIGTERM"));
+try {
+  process.exitCode = await new Promise<number>((resolve, reject) => {
+    child.once("error", reject);
+    child.once("exit", (code) => resolve(code ?? 1));
+  });
+} finally {
+  NodeTimers.clearInterval(heartbeat);
+  await relay.close();
+  await Promise.all(registrations.values());
+  NodeFS.closeSync(logFd);
+  if (diagnosticCount) process.stderr.write(`\nShared Codex diagnostics: ${logPath}\n`);
+  const finalState = latest as TerminalObservation | null;
+  if (finalState)
+    process.stderr.write(
+      `\nResume this shared conversation: bridge codex resume ${finalState.nativeThreadId}\n`,
+    );
+}
