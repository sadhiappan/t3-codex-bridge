index 000000000..48cdbe2bb
--- /dev/null
+++ b/apps/server/src/provider/sharedCodexTerminalState.ts
@@ -0,0 +1,122 @@
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+
+const Identity = Schema.Union([Schema.String, Schema.Number]);
+const Status = Schema.Struct({
+  type: Schema.String,
+  activeFlags: Schema.optionalKey(Schema.Array(Schema.String)),
+});
+const decodeFrame = Schema.decodeUnknownOption(
+  Schema.Struct({
+    id: Schema.optionalKey(Identity),
+    method: Schema.optionalKey(Schema.String),
+    result: Schema.optionalKey(
+      Schema.Struct({
+        thread: Schema.optionalKey(
+          Schema.Struct({
+            id: Schema.String,
+            status: Schema.optionalKey(Status),
+            ephemeral: Schema.optionalKey(Schema.Boolean),
+          }),
+        ),
+      }),
+    ),
+    params: Schema.optionalKey(
+      Schema.Struct({
+        threadId: Schema.optionalKey(Schema.String),
+        turnId: Schema.optionalKey(Schema.String),
+        requestId: Schema.optionalKey(Identity),
+        status: Schema.optionalKey(Status),
+        turn: Schema.optionalKey(
+          Schema.Struct({ id: Schema.String, status: Schema.optionalKey(Schema.String) }),
+        ),
+      }),
+    ),
+  }),
+);
+
+export interface TerminalObservation {
+  nativeThreadId: string;
+  state: "idle" | "working" | "waiting" | "done" | "unknown";
+  turnId: string | null;
+}
+
+export function makeTerminalObserver() {
+  const opens = new Set<string | number>();
+  const approvals = new Set<string | number>();
+  let current: TerminalObservation | null = null;
+  function applyStatus(status: typeof Status.Type) {
+    if (!current) return;
+    if (status.type === "active")
+      current.state = status.activeFlags?.length ? "waiting" : "working";
+    else if (status.type === "idle") {
+      if (current.state !== "done") current.state = "idle";
+    } else current.state = "unknown";
+  }
+  return {
+    state: () => (current ? { ...current } : null),
+    send(value: unknown) {
+      const frame = Option.getOrUndefined(decodeFrame(value));
+      if (
+        frame?.id !== undefined &&
+        ["thread/start", "thread/resume", "thread/fork"].includes(frame.method ?? "")
+      )
+        opens.add(frame.id);
+    },
+    receive(value: unknown) {
+      const frame = Option.getOrUndefined(decodeFrame(value));
+      if (!frame) return;
+      if (
+        !frame.method &&
+        frame.id !== undefined &&
+        opens.delete(frame.id) &&
+        frame.result?.thread &&
+        !frame.result.thread.ephemeral
+      ) {
+        current = { nativeThreadId: frame.result.thread.id, state: "unknown", turnId: null };
+        approvals.clear();
+        if (frame.result.thread.status) applyStatus(frame.result.thread.status);
+        return;
+      }
+      if (!current || frame.params?.threadId !== current.nativeThreadId) return;
+      const params = frame.params;
+      if (frame.method === "turn/started" && params.turn) {
+        current.turnId = params.turn.id;
+        current.state = "working";
+        approvals.clear();
+      } else if (
+        frame.method === "turn/completed" &&
+        params.turn &&
+        (!current.turnId || current.turnId === params.turn.id)
+      ) {
+        current.turnId = params.turn.id;
+        current.state = params.turn.status === "interrupted" ? "idle" : "done";
+        approvals.clear();
+      } else if (
+        frame.id !== undefined &&
+        [
+          "item/commandExecution/requestApproval",
+          "item/fileChange/requestApproval",
+          "item/tool/requestUserInput",
+          "mcpServer/elicitation/request",
+        ].includes(frame.method ?? "")
+      ) {
+        if (params.turnId && current.turnId && params.turnId !== current.turnId) return;
+        approvals.add(frame.id);
+        current.state = "waiting";
+      } else if (
+        frame.method === "serverRequest/resolved" &&
+        params.requestId !== undefined &&
+        approvals.delete(params.requestId)
+      ) {
+        current.state = approvals.size ? "waiting" : "working";
+      } else if (frame.method === "thread/status/changed" && params.status)
+        applyStatus(params.status);
+    },
+    disconnect() {
+      opens.clear();
+      approvals.clear();
+      if (current) current.state = "unknown";
+    },
+  };
+}
