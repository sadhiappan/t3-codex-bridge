+import { decideOrchestrationCommand } from "./decider.ts";
+import { createEmptyReadModel, projectEvent } from "./projector.ts";
+
+it.layer(NodeServices.layer)("observed native messages", (it) => {
+  it.effect("projects external prompts once and deduplicates echoes using client identity", () =>
+    Effect.gen(function* () {
+      const createdAt = "2026-09-09T12:00:00.000Z";
+      const threadId = ThreadId.make("shared-thread");
+      let model = yield* projectEvent(createEmptyReadModel(createdAt), {
+        sequence: 1,
+        eventId: EventId.make("created"),
+        aggregateKind: "thread",
+        aggregateId: threadId,
+        type: "thread.created",
+        occurredAt: createdAt,
+        commandId: CommandId.make("create"),
+        causationEventId: null,
+        correlationId: CommandId.make("create"),
+        metadata: {},
+        payload: {
+          threadId,
+          projectId: ProjectId.make("project"),
+          title: "Shared",
+          modelSelection: { instanceId: ProviderInstanceId.make("codex"), model: "gpt-5" },
+          runtimeMode: "approval-required",
+          interactionMode: "default",
+          branch: null,
+          worktreePath: null,
+          createdAt,
+          updatedAt: createdAt,
+        },
+      });
+      const command = {
+        type: "thread.message.observe" as const,
+        commandId: CommandId.make("observe"),
+        threadId,
+        messageId: MessageId.make("native-user:1"),
+        turnId: TurnId.make("turn-1"),
+        role: "user" as const,
+        text: "From Ghostty",
+        createdAt,
+      };
+      const first = yield* decideOrchestrationCommand({ command, readModel: model });
+      expect(first).toMatchObject({
+        type: "thread.message-sent",
+        payload: { text: "From Ghostty", turnId: "turn-1", streaming: false },
+      });
+      model = yield* projectEvent(model, { ...first, sequence: 2 } as OrchestrationEvent);
+      expect(yield* decideOrchestrationCommand({ command, readModel: model })).toEqual([]);
+      expect(
+        yield* decideOrchestrationCommand({
+          command: {
+            ...command,
+            messageId: MessageId.make("different-native-item"),
+            clientMessageId: command.messageId,
+            text: "A provider-expanded version of the original prompt",
+          },
+          readModel: model,
+        }),
+      ).toEqual([]);
+      expect(model.threads[0]?.messages.map((message) => message.text)).toEqual(["From Ghostty"]);
+    }),
+  );
+});
