@@ -0,0 +1,93 @@
+import { ThreadId } from "@t3tools/contracts";
+import { describe, expect, it } from "vite-plus/test";
+
+import { nativeMessages, shouldAttachSharedThread } from "./SharedCodexDiscovery.ts";
+
+describe("native history reconciliation", () => {
+  it("keeps native identities and excludes unfinished assistant snapshots", () => {
+    const history = {
+      id: "native",
+      cwd: "/project",
+      name: null,
+      preview: "hello",
+      createdAt: 1000,
+      updatedAt: 1002,
+      turns: [
+        {
+          id: "done",
+          status: "completed",
+          startedAt: 1000,
+          items: [
+            {
+              type: "userMessage",
+              id: "u1",
+              clientId: "t3-message",
+              content: [{ type: "text", text: "hello" }],
+            },
+            { type: "agentMessage", id: "a1", text: "done" },
+            { type: "commandExecution", id: "tool" },
+          ],
+        },
+        {
+          id: "active",
+          status: "inProgress",
+          items: [
+            { type: "userMessage", id: "u2", content: [{ type: "text", text: "next" }] },
+            { type: "agentMessage", id: "a2", text: "partial" },
+          ],
+        },
+      ],
+    };
+    const result = nativeMessages(ThreadId.make("t3"), history);
+    expect(
+      result.map(({ messageId, clientMessageId, text, turnId }) => ({
+        messageId,
+        clientMessageId,
+        text,
+        turnId,
+      })),
+    ).toEqual([
+      {
+        messageId: "native-user:t3:u1",
+        clientMessageId: "t3-message",
+        text: "hello",
+        turnId: "done",
+      },
+      { messageId: "assistant:a1", clientMessageId: undefined, text: "done", turnId: "done" },
+      {
+        messageId: "native-user:t3:u2",
+        clientMessageId: undefined,
+        text: "next",
+        turnId: "active",
+      },
+    ]);
+    expect(result[0]?.createdAt).toBe("1970-01-01T00:16:40.000Z");
+    expect(result[1]?.createdAt).toBe("1970-01-01T00:16:40.001Z");
+  });
+});
+
+describe("shared discovery after idle reaping", () => {
+  const stopped = { status: "stopped", lastSeenAt: "2026-09-12T12:00:00.500Z" };
+  const idle = { updatedAt: Date.parse("2026-09-12T12:00:00Z") / 1000, status: { type: "idle" } };
+  it("keeps unchanged reaped sessions detached across discovery sweeps", () => {
+    expect(shouldAttachSharedThread(stopped, idle)).toBe(false);
+    expect(shouldAttachSharedThread(stopped, { ...idle, updatedAt: idle.updatedAt - 3600 })).toBe(
+      false,
+    );
+  });
+  it("reattaches for native work or an approval wait even within the same timestamp second", () => {
+    expect(shouldAttachSharedThread(stopped, { ...idle, status: { type: "active" } })).toBe(true);
+  });
+  it("reconciles work completed while detached", () => {
+    expect(shouldAttachSharedThread(stopped, { ...idle, updatedAt: idle.updatedAt + 1 })).toBe(
+      true,
+    );
+  });
+  it("imports new sessions and restores connections that were not intentionally stopped", () => {
+    expect(shouldAttachSharedThread(undefined, idle)).toBe(true);
+    expect(shouldAttachSharedThread({ ...stopped, status: "running" }, idle)).toBe(true);
+  });
+  it("does not treat an absent status as activity", () => {
+    expect(shouldAttachSharedThread(stopped, { updatedAt: idle.updatedAt })).toBe(false);
+  });
+});
diff --git a/apps/server/src/provider/SharedCodexDiscovery.ts b/apps/server/src/provider/SharedCodexDiscovery.ts
new file mode 100644
index 000000000..4c73bf773
--- /dev/null
+++ b/apps/server/src/provider/SharedCodexDiscovery.ts
@@ -0,0 +1,375 @@
+import {
+  CommandId,
+  MessageId,
+  ProjectId,
+  ProviderInstanceId,
+  ProviderDriverKind,
+  ThreadId,
+  TurnId,
+} from "@t3tools/contracts";
+import * as Crypto from "effect/Crypto";
+import * as DateTime from "effect/DateTime";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as Option from "effect/Option";
+import * as Schema from "effect/Schema";
+import * as Schedule from "effect/Schedule";
+import * as CodexClient from "effect-codex-app-server/client";
+
+import { OrchestrationEngineService } from "../orchestration/Services/OrchestrationEngine.ts";
+import { ProjectionSnapshotQuery } from "../orchestration/Services/ProjectionSnapshotQuery.ts";
+import { ProviderService } from "./Services/ProviderService.ts";
+import { ProviderSessionDirectory } from "./Services/ProviderSessionDirectory.ts";
+import { makeSharedCodexTransport } from "./Layers/codexSharedTransport.ts";
+import { sharedCodexSocket } from "./sharedCodex.ts";
+import { registeredSharedThreads, unsharedThreads } from "./sharedCodexRegistration.ts";
+
+class SharedCodexConfigError extends Schema.TaggedErrorClass<SharedCodexConfigError>()(
+  "SharedCodexConfigError",
+  { message: Schema.String },
+) {}
+
+const NativeThread = Schema.Struct({
+  id: Schema.String,
+  ephemeral: Schema.optionalKey(Schema.Boolean),
+  parentThreadId: Schema.optionalKey(Schema.NullOr(Schema.String)),
+  cwd: Schema.String,
+  preview: Schema.String,
+  name: Schema.NullOr(Schema.String),
+  model: Schema.optionalKey(Schema.NullOr(Schema.String)),
+  createdAt: Schema.Number,
+  updatedAt: Schema.Number,
+  status: Schema.optionalKey(Schema.Struct({ type: Schema.String })),
+  turns: Schema.Array(
+    Schema.Struct({
+      id: Schema.String,
+      status: Schema.String,
+      startedAt: Schema.optionalKey(Schema.NullOr(Schema.Number)),
+      items: Schema.Array(Schema.Unknown),
+    }),
+  ),
+});
+const NativeUserMessage = Schema.Struct({
+  type: Schema.Literal("userMessage"),
+  id: Schema.String,
+  clientId: Schema.optionalKey(Schema.NullOr(Schema.String)),
+  content: Schema.Array(
+    Schema.Struct({ type: Schema.String, text: Schema.optionalKey(Schema.String) }),
+  ),
+});
+const NativeAgentMessage = Schema.Struct({
+  type: Schema.Literal("agentMessage"),
+  id: Schema.String,
+  text: Schema.String,
+});
+const decodeNativeMessage = Schema.decodeUnknownOption(
+  Schema.Union([NativeUserMessage, NativeAgentMessage]),
+);
+const decodeThread = Schema.decodeUnknownEffect(Schema.Struct({ thread: NativeThread }));
+const decodeThreadPage = Schema.decodeUnknownEffect(
+  Schema.Struct({ data: Schema.Array(NativeThread), nextCursor: Schema.NullOr(Schema.String) }),
+);
+const decodeLoadedPage = Schema.decodeUnknownEffect(
+  Schema.Struct({ data: Schema.Array(Schema.String), nextCursor: Schema.NullOr(Schema.String) }),
+);
+const decodeProjectRoots = Schema.decodeUnknownEffect(
+  Schema.fromJsonString(Schema.Array(Schema.String)),
+);
+
+export function shouldAttachSharedThread(
+  binding: { status?: string; lastSeenAt: string } | undefined,
+  native: { updatedAt: number; status?: { type: string } },
+): boolean {
+  if (binding?.status !== "stopped") return true;
+  // A loaded thread can be waiting for native idle expiry. Discovery must not
+  // restart its subscription solely because T3's idle reaper detached it.
+  return (
+    native.status?.type === "active" || native.updatedAt * 1000 > Date.parse(binding.lastSeenAt)
+  );
+}
+
+export function nativeMessages(threadId: ThreadId, thread: typeof NativeThread.Type) {
+  return thread.turns.flatMap((turn) =>
+    turn.items.flatMap((raw, itemIndex) => {
+      const message = Option.getOrUndefined(decodeNativeMessage(raw));
+      if (!message || (message.type === "agentMessage" && turn.status === "inProgress")) return [];
+      const user = message.type === "userMessage";
+      const text = user
+        ? message.content
+            .flatMap((part) => (part.type === "text" && part.text ? [part.text] : []))
+            .join("\n")
+        : message.text;
+      if (!text) return [];
+      return [
+        {
+          threadId,
+          messageId: MessageId.make(
+            user ? `native-user:${threadId}:${message.id}` : `assistant:${message.id}`,
+          ),
+          ...(user && message.clientId
+            ? { clientMessageId: MessageId.make(message.clientId) }
+            : {}),
+          turnId: TurnId.make(turn.id),
+          role: user ? ("user" as const) : ("assistant" as const),
+          text,
+          createdAt: DateTime.formatIso(
+            DateTime.makeUnsafe((turn.startedAt ?? thread.createdAt) * 1000 + itemIndex),
+          ),
+        },
+      ];
+    }),
+  );
+}
+
+export const startSharedCodexDiscovery = Effect.fn("startSharedCodexDiscovery")(function* () {
+  const socketPath = sharedCodexSocket("codex");
+  if (!socketPath) return;
+  const roots = yield* decodeProjectRoots(process.env.T3_CODEX_SHARED_PROJECTS ?? "[]");
+  const registrationDirectory = process.env.T3_CODEX_SHARED_REGISTRATIONS;
+  if ((!roots.length && !registrationDirectory) || roots.some((root) => !root.startsWith("/"))) {
+    return yield* new SharedCodexConfigError({
+      message: "Configure absolute T3_CODEX_SHARED_PROJECTS or T3_CODEX_SHARED_REGISTRATIONS.",
+    });
+  }
+  const crypto = yield* Crypto.Crypto;
+  const environmentKey = Buffer.from(
+    yield* crypto.digest("SHA-256", new TextEncoder().encode(socketPath)),
+  )
+    .toString("hex")
+    .slice(0, 16);
+  const engine = yield* OrchestrationEngineService;
+  const snapshots = yield* ProjectionSnapshotQuery;
+  const providers = yield* ProviderService;
+  const directory = yield* ProviderSessionDirectory;
+  const instanceId = ProviderInstanceId.make("codex");
+  const commandId = Effect.map(crypto.randomUUIDv4, CommandId.make);
+
+  const connection = Effect.scoped(
+    Effect.gen(function* () {
+      const transport = yield* makeSharedCodexTransport(socketPath);
+      const context = yield* Layer.build(
+        CodexClient.layerStdio(transport.stdio, {}, transport.terminationError),
+      );
+      const client = yield* CodexClient.CodexAppServerClient.pipe(Effect.provide(context));
+      yield* client.raw.request("initialize", {
+        clientInfo: { name: "t3_shared_discovery", version: "0.1.0" },
+        capabilities: { experimentalApi: true },
+      });
+      yield* client.raw.notify("initialized");
+      const synchronize = Effect.gen(function* () {
+        const disabled = new Set(
+          registrationDirectory
+            ? yield* Effect.tryPromise(() => unsharedThreads(registrationDirectory))
+            : [],
+        );
+        if (disabled.size) {
+          const bindings = yield* directory.listBindings();
+          for (const binding of bindings) {
+            const cursor = binding.resumeCursor;
+            if (
+              binding.providerInstanceId === instanceId &&
+              binding.status !== "stopped" &&
+              typeof cursor === "object" &&
+              cursor !== null &&
+              "threadId" in cursor &&
+              typeof cursor.threadId === "string" &&
+              disabled.has(cursor.threadId)
+            ) {
+              yield* providers.stopSession({ threadId: binding.threadId });
+            }
+          }
+        }
+        const loaded = new Set<string>();
+        let cursor: string | null = null;
+        do {
+          const page: { data: ReadonlyArray<string>; nextCursor: string | null } = yield* client.raw
+            .request("thread/loaded/list", { cursor, limit: 100 })
+            .pipe(Effect.flatMap(decodeLoadedPage));
+          for (const id of page.data) loaded.add(id);
+          cursor = page.nextCursor;
+        } while (cursor);
+        const candidates: Array<typeof NativeThread.Type> = [];
+        if (roots.length)
+          do {
+            const page: {
+              data: ReadonlyArray<typeof NativeThread.Type>;
+              nextCursor: string | null;
+            } = yield* client.raw
+              .request("thread/list", {
+                cursor,
+                cwd: roots,
+                limit: 100,
+                useStateDbOnly: true,
+                sourceKinds: ["cli", "appServer", "vscode"],
+              })
+              .pipe(Effect.flatMap(decodeThreadPage));
+            candidates.push(
+              ...page.data.filter(
+                (thread) =>
+                  !thread.ephemeral &&
+                  !thread.parentThreadId &&
+                  loaded.has(thread.id) &&
+                  roots.includes(thread.cwd) &&
+                  thread.preview.length > 0,
+              ),
+            );
+            cursor = page.nextCursor;
+          } while (cursor);
+        if (registrationDirectory) {
+          const registered = yield* Effect.tryPromise(() =>
+            registeredSharedThreads(registrationDirectory),
+          );
+          for (const id of registered) {
+            if (!loaded.has(id) || candidates.some((candidate) => candidate.id === id)) continue;
+            yield* client.raw.request("thread/read", { threadId: id, includeTurns: false }).pipe(
+              Effect.flatMap(decodeThread),
+              Effect.tap(({ thread }) =>
+                Effect.sync(() => {
+                  if (!thread.ephemeral && !thread.parentThreadId && thread.preview.length > 0)
+                    candidates.push(thread);
+                }),
+              ),
+              Effect.catch((cause) =>
+                Effect.logWarning("Registered shared thread could not be read", {
+                  nativeThreadId: id,
+                  cause,
+                }),
+              ),
+            );
+          }
+        }
+        const shell = yield* snapshots.getShellSnapshot();
+        const projectIds = new Map(
+          shell.projects.map((project) => [project.workspaceRoot, project.id]),
+        );
+        const bindings = yield* directory.listBindings();
+        const sessions = yield* providers.listSessions();
+        for (const native of candidates) {
+          if (disabled.has(native.id)) continue;
+          yield* Effect.gen(function* () {
+            const existingBinding = bindings.find(
+              (binding) =>
+                binding.providerInstanceId === instanceId &&
+                typeof binding.resumeCursor === "object" &&
+                binding.resumeCursor !== null &&
+                "threadId" in binding.resumeCursor &&
+                binding.resumeCursor.threadId === native.id,
+            );
+            const threadId =
+              existingBinding?.threadId ?? ThreadId.make(`shared:${environmentKey}:${native.id}`);
+            const existing = yield* snapshots.getThreadShellById(threadId);
+            if (Option.isSome(existing) && existing.value.archivedAt !== null) return;
+            if (Option.isNone(existing)) {
+              const saved = (yield* snapshots.getCommandReadModel()).threads.find(
+                (thread) => thread.id === threadId,
+              );
+              if (saved?.deletedAt) return;
+            }
+            const live = sessions.find(
+              (session) =>
+                session.threadId === threadId &&
+                (session.status === "ready" || session.status === "running"),
+            );
+            if (live) return;
+            if (Option.isSome(existing) && !shouldAttachSharedThread(existingBinding, native))
+              return;
+            const now = DateTime.formatIso(yield* DateTime.now);
+            const existingProjectId = projectIds.get(native.cwd);
+            const projectId =
+              existingProjectId ??
+              ProjectId.make(
+                `shared:${environmentKey}:${Buffer.from(
+                  yield* crypto.digest("SHA-256", new TextEncoder().encode(native.cwd)),
+                )
+                  .toString("hex")
+                  .slice(0, 16)}`,
+              );
+            if (!existingProjectId) {
+              yield* engine.dispatch({
+                type: "project.create",
+                commandId: yield* commandId,
+                projectId,
+                title: native.cwd.split("/").findLast(Boolean) ?? "Shared Codex",
+                workspaceRoot: native.cwd,
+                createdAt: now,
+              });
+              projectIds.set(native.cwd, projectId);
+            }
+            if (Option.isNone(existing)) {
+              yield* directory.upsert(
+                {
+                  threadId,
+                  provider: ProviderDriverKind.make("codex"),
+                  providerInstanceId: instanceId,
+                  status: "stopped",
+                  resumeCursor: { threadId: native.id },
+                  runtimeMode: "approval-required",
+                  runtimePayload: { cwd: native.cwd },
+                },
+                { onConflict: "ignore" },
+              );
+              yield* engine.dispatch({
+                type: "thread.create",
+                commandId: yield* commandId,
+                threadId,
+                projectId,
+                title: (native.name ?? native.preview.slice(0, 100)) || "Shared Codex",
+                modelSelection: { instanceId, model: native.model ?? "unknown" },
+                runtimeMode: "approval-required",
+                interactionMode: "default",
+                branch: null,
+                worktreePath: null,
+                createdAt: now,
+                historyImport: true,
+              });
+            }
+            const before = yield* client.raw
+              .request("thread/read", { threadId: native.id, includeTurns: true })
+              .pipe(Effect.flatMap(decodeThread));
+            for (const message of nativeMessages(threadId, before.thread)) {
+              yield* engine.dispatch({
+                type: "thread.message.observe",
+                commandId: yield* commandId,
+                ...message,
+              });
+            }
+            yield* providers.startSession(threadId, {
+              threadId,
+              provider: ProviderDriverKind.make("codex"),
+              providerInstanceId: instanceId,
+              cwd: native.cwd,
+              runtimeMode: "approval-required",
+              resumeCursor: { threadId: native.id },
+              modelSelection: { instanceId, model: native.model ?? "unknown" },
+            });
+            const after = yield* client.raw
+              .request("thread/read", { threadId: native.id, includeTurns: true })
+              .pipe(Effect.flatMap(decodeThread));
+            for (const message of nativeMessages(threadId, after.thread)) {
+              yield* engine.dispatch({
+                type: "thread.message.observe",
+                commandId: yield* commandId,
+                ...message,
+              });
+            }
+          }).pipe(
+            Effect.catch((cause) =>
+              Effect.logWarning("Shared Codex conversation could not be synchronized", {
+                nativeThreadId: native.id,
+                cause,
+              }),
+            ),
+          );
+        }
+      });
+      yield* synchronize.pipe(Effect.repeat(Schedule.spaced("2 seconds")));
+    }),
+  );
+  yield* connection.pipe(
+    Effect.catch((cause) =>
+      Effect.logWarning("Shared Codex discovery disconnected; retrying", { cause }),
+    ),
+    Effect.repeat(Schedule.spaced("5 seconds")),
+    Effect.forkScoped,
+  );
+});
