+import { describe, expect, it } from "vite-plus/test";
+import { makeTerminalObserver } from "./sharedCodexTerminalState.ts";
+
+describe("shared terminal identity", () => {
+  it("ignores native ephemeral helper sessions on the terminal connection", () => {
+    const observer = makeTerminalObserver();
+    observer.send({ id: 1, method: "thread/start" });
+    observer.receive({ id: 1, result: { thread: { id: "conversation" } } });
+    observer.send({ id: 2, method: "thread/start", params: { ephemeral: true } });
+    observer.receive({ id: 2, result: { thread: { id: "helper", ephemeral: true } } });
+    expect(observer.state()?.nativeThreadId).toBe("conversation");
+  });
+  it("binds only successful replies to this terminal's open requests and follows session switches", () => {
+    const observer = makeTerminalObserver();
+    observer.receive({ method: "thread/started", params: { thread: { id: "foreign" } } });
+    expect(observer.state()).toBeNull();
+    observer.send({ id: 1, method: "thread/start" });
+    observer.receive({ id: 1, result: { thread: { id: "new", status: { type: "idle" } } } });
+    expect(observer.state()).toMatchObject({ nativeThreadId: "new", state: "idle" });
+    observer.send({ id: 2, method: "thread/resume" });
+    observer.receive({ id: 2, error: { message: "unavailable" } });
+    expect(observer.state()?.nativeThreadId).toBe("new");
+    observer.send({ id: 3, method: "thread/resume" });
+    observer.receive({
+      id: 3,
+      result: {
+        thread: { id: "resumed", status: { type: "active", activeFlags: ["waitingOnApproval"] } },
+      },
+    });
+    expect(observer.state()).toMatchObject({ nativeThreadId: "resumed", state: "waiting" });
+    observer.receive({
+      method: "turn/completed",
+      params: { threadId: "new", turn: { id: "old", status: "completed" } },
+    });
+    expect(observer.state()?.state).toBe("waiting");
+  });
+
+  it("tracks phone turns and approvals without retaining prompt or tool content", () => {
+    const observer = makeTerminalObserver();
+    observer.send({ id: "open", method: "thread/resume", params: { secret: "do not retain" } });
+    observer.receive({
+      id: "open",
+      result: { thread: { id: "native", status: { type: "idle" } } },
+    });
+    observer.receive({
+      method: "turn/started",
+      params: { threadId: "native", turn: { id: "turn" } },
+    });
+    expect(observer.state()?.state).toBe("working");
+    observer.receive({
+      id: 0,
+      method: "item/commandExecution/requestApproval",
+      params: { threadId: "native", turnId: "turn", command: "private" },
+    });
+    expect(observer.state()?.state).toBe("waiting");
+    observer.receive({
+      method: "serverRequest/resolved",
+      params: { threadId: "native", requestId: 0 },
+    });
+    expect(observer.state()?.state).toBe("working");
+    observer.receive({
+      method: "turn/completed",
+      params: { threadId: "native", turn: { id: "stale", status: "completed" } },
+    });
+    expect(observer.state()?.state).toBe("working");
+    observer.receive({
+      method: "turn/completed",
+      params: { threadId: "native", turn: { id: "turn", status: "completed" } },
+    });
+    observer.receive({
+      method: "thread/status/changed",
+      params: { threadId: "native", status: { type: "idle" } },
+    });
+    expect(observer.state()).toMatchObject({ state: "done", turnId: "turn" });
+    expect(JSON.stringify(observer.state())).not.toContain("private");
+    expect(JSON.stringify(observer.state())).not.toContain("do not retain");
+    observer.disconnect();
+    expect(observer.state()?.state).toBe("unknown");
+  });
+});
