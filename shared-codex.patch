+// @effect-diagnostics nodeBuiltinImport:off - Exercises the real filesystem registration boundary.
+import * as NodeFSP from "node:fs/promises";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+import { describe, expect, it } from "vite-plus/test";
+import {
+  registerSharedThread,
+  registeredSharedThreads,
+  unshareThread,
+  unsharedThreads,
+} from "./sharedCodexRegistration.ts";
+
+describe("shared thread registration", () => {
+  it("disables discovery until explicitly registered again", async () => {
+    const directory = await NodeFSP.mkdtemp(NodePath.join(NodeOS.tmpdir(), "t3-unshare-"));
+    try {
+      await registerSharedThread(directory, "session-one");
+      await unshareThread(directory, "session-one");
+      expect(await registeredSharedThreads(directory)).toEqual([]);
+      expect(await unsharedThreads(directory)).toEqual(["session-one"]);
+      await unshareThread(directory, "session-one");
+      await expect(unshareThread(directory, "../escape")).rejects.toThrow("identity");
+      await registerSharedThread(directory, "session-one");
+      expect(await unsharedThreads(directory)).toEqual([]);
+      expect(await registeredSharedThreads(directory)).toEqual(["session-one"]);
+    } finally {
+      await NodeFSP.rm(directory, { recursive: true, force: true });
+    }
+  });
+  it("persists concurrent registrations without importing unrelated files", async () => {
+    const directory = await NodeFSP.mkdtemp(NodePath.join(NodeOS.tmpdir(), "t3-registration-"));
+    try {
+      await Promise.all([
+        registerSharedThread(directory, "thread-one"),
+        registerSharedThread(directory, "thread-two"),
+      ]);
+      await registerSharedThread(directory, "thread-one");
+      await NodeFSP.writeFile(NodePath.join(directory, "unrelated"), "ignore");
+      expect((await registeredSharedThreads(directory)).sort()).toEqual([
+        "thread-one",
+        "thread-two",
+      ]);
+      expect((await NodeFSP.stat(NodePath.join(directory, "thread-one.thread"))).mode & 0o777).toBe(
+        0o600,
+      );
+      await expect(registerSharedThread(directory, "../escape")).rejects.toThrow("identity");
+    } finally {
+      await NodeFSP.rm(directory, { recursive: true, force: true });
+    }
+  });
+});
