@@ -0,0 +1,78 @@
+const localCommands = new Set([
+  "exec",
+  "e",
+  "review",
+  "login",
+  "logout",
+  "mcp",
+  "plugin",
+  "app-server",
+  "remote-control",
+  "app",
+  "completion",
+  "update",
+  "doctor",
+  "sandbox",
+  "debug",
+  "apply",
+  "a",
+  "queue",
+  "archive",
+  "delete",
+  "migrate-rollouts",
+  "unarchive",
+  "cloud",
+  "exec-server",
+  "features",
+  "help",
+  "agents",
+]);
+const valueOptions = new Set([
+  "-c",
+  "--config",
+  "--enable",
+  "--disable",
+  "-i",
+  "--image",
+  "-m",
+  "--model",
+  "--local-provider",
+  "-p",
+  "--profile",
+  "-s",
+  "--sandbox",
+  "-C",
+  "--cd",
+  "--add-dir",
+  "-a",
+  "--ask-for-approval",
+  "--remote-auth-token-env",
+]);
+
+export function sharedLaunchArgs(args: string[], cwd: string): string[] | null {
+  let command: string | undefined;
+  let hasDirectory = false;
+  for (let index = 0; index < args.length; index += 1) {
+    const arg = args[index]!;
+    if (arg === "--") break;
+    if (
+      ["--help", "-h", "--version", "-V", "--remote"].includes(arg) ||
+      arg.startsWith("--remote=")
+    )
+      return null;
+    if (
+      arg === "-C" ||
+      arg === "--cd" ||
+      arg.startsWith("--cd=") ||
+      (arg.startsWith("-C") && arg.length > 2)
+    )
+      hasDirectory = true;
+    if (valueOptions.has(arg)) {
+      index += 1;
+      continue;
+    }
+    if (!arg.startsWith("-") && command === undefined) command = arg;
+  }
+  if (command && localCommands.has(command)) return null;
+  return hasDirectory || command === "resume" || command === "fork" ? args : ["-C", cwd, ...args];
+}
