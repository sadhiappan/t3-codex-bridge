+import { describe, expect, it } from "vite-plus/test";
+import { sharedLaunchArgs } from "./sharedCodexLaunch.ts";
+
+describe("everyday Codex routing", () => {
+  it("preserves native utilities, automation, and explicit remote connections", () => {
+    for (const args of [
+      ["exec", "task"],
+      ["-p", "fast", "review"],
+      ["app-server", "daemon", "start"],
+      ["--version"],
+      ["--remote=unix://", "resume"],
+    ])
+      expect(sharedLaunchArgs(args, "/project")).toBeNull();
+  });
+  it("uses the terminal directory for new sessions while retaining arguments exactly", () => {
+    expect(sharedLaunchArgs(["-p", "fast", "fix this"], "/a b")).toEqual([
+      "-C",
+      "/a b",
+      "-p",
+      "fast",
+      "fix this",
+    ]);
+    expect(sharedLaunchArgs(["--", "exec"], "/a b")).toEqual(["-C", "/a b", "--", "exec"]);
+    expect(sharedLaunchArgs(["--cd=/other"], "/project")).toEqual(["--cd=/other"]);
+  });
+  it("does not overwrite a resumed or forked conversation's directory", () => {
+    expect(sharedLaunchArgs(["resume", "native-id"], "/other")).toEqual(["resume", "native-id"]);
+    expect(sharedLaunchArgs(["fork", "--last"], "/other")).toEqual(["fork", "--last"]);
+  });
+});
