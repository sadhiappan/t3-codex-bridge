+// @effect-diagnostics nodeBuiltinImport:off - Local launcher registration boundary.
+import * as NodeFSP from "node:fs/promises";
+import * as NodePath from "node:path";
+
+const threadIdentity = /^[a-zA-Z0-9_-]+$/;
+export async function registerSharedThread(directory: string, threadId: string) {
+  if (!NodePath.isAbsolute(directory))
+    throw new Error("Shared registration directory must be absolute");
+  if (!threadIdentity.test(threadId)) throw new Error("Invalid native thread identity");
+  await NodeFSP.mkdir(directory, { recursive: true, mode: 0o700 });
+  await NodeFSP.rm(NodePath.join(directory, threadId + ".unshared"), { force: true });
+  await NodeFSP.writeFile(NodePath.join(directory, threadId + ".thread"), "", { mode: 0o600 });
+}
+
+export async function registeredSharedThreads(directory: string) {
+  if (!NodePath.isAbsolute(directory))
+    throw new Error("Shared registration directory must be absolute");
+  return (await NodeFSP.readdir(directory)).flatMap((name) => {
+    const id = name.endsWith(".thread") ? name.slice(0, -7) : "";
+    return threadIdentity.test(id) ? [id] : [];
+  });
+}
+
+export async function unshareThread(directory: string, threadId: string) {
+  if (!NodePath.isAbsolute(directory))
+    throw new Error("Shared registration directory must be absolute");
+  if (!threadIdentity.test(threadId)) throw new Error("Invalid native thread identity");
+  await NodeFSP.mkdir(directory, { recursive: true, mode: 0o700 });
+  await NodeFSP.writeFile(NodePath.join(directory, threadId + ".unshared"), "", { mode: 0o600 });
+  await NodeFSP.rm(NodePath.join(directory, threadId + ".thread"), { force: true });
+}
+
+export async function unsharedThreads(directory: string) {
+  if (!NodePath.isAbsolute(directory))
+    throw new Error("Shared registration directory must be absolute");
+  return (await NodeFSP.readdir(directory)).flatMap((name) => {
+    const id = name.endsWith(".unshared") ? name.slice(0, -9) : "";
+    return threadIdentity.test(id) ? [id] : [];
+  });
+}
diff --git a/apps/server/src/provider/sharedCodexTerminalRelay.test.ts b/apps/server/src/provider/sharedCodexTerminalRelay.test.ts
new file mode 100644
index 000000000..5dfff790b
--- /dev/null
+++ b/apps/server/src/provider/sharedCodexTerminalRelay.test.ts
@@ -0,0 +1,267 @@
+// @effect-diagnostics nodeBuiltinImport:off - exercises actual local WebSocket peers.
+import * as NodeFSP from "node:fs/promises";
+import * as NodeHttp from "node:http";
+import { NodeWS } from "@effect/platform-node/NodeSocket";
+import { expect, it } from "vite-plus/test";
+import { startTerminalRelay } from "./sharedCodexTerminalRelay.ts";
+import type { TerminalObservation } from "./sharedCodexTerminalState.ts";
+
+it("forwards unchanged frames, captures actual identity, and detaches without answering approvals", async () => {
+  const directory = await NodeFSP.mkdtemp("/tmp/t3-relay-test-");
+  const upstreamSocket = directory + "/native.sock";
+  const http = NodeHttp.createServer();
+  const server = new NodeWS.WebSocketServer({ server: http });
+  const received: string[] = [];
+  let native: InstanceType<typeof NodeWS.WebSocket> | undefined;
+  const nativeClosed = new Promise<void>((resolve) =>
+    server.on("connection", (peer, request) => {
+      native = peer;
+      expect(request.headers["sec-websocket-extensions"]).toBeUndefined();
+      peer.on("close", () => resolve());
+      peer.on("message", (data) => {
+        received.push(data.toString());
+        peer.send('{"id":7,"result":{"thread":{"id":"native-7","status":{"type":"idle"}}}}');
+      });
+    }),
+  );
+  await new Promise<void>((resolve) => http.listen(upstreamSocket, resolve));
+  const states: Array<TerminalObservation | null> = [];
+  const errors: Error[] = [];
+  const relay = await startTerminalRelay({
+    upstreamSocket,
+    onState: (state) => states.push(state),
+    onError: (error) => errors.push(error),
+  });
+  const terminal = new NodeWS.WebSocket(`ws+unix://${relay.socketPath}:/`, {
+    perMessageDeflate: false,
+  });
+  try {
+    await new Promise<void>((resolve, reject) => {
+      terminal.once("open", resolve);
+      terminal.once("error", reject);
+    });
+    const response = new Promise<string>((resolve) =>
+      terminal.once("message", (data) => resolve(data.toString())),
+    );
+    const frame =
+      '{ "id":7, "method":"thread/resume", "params":{"threadId":"native-7","unknownFutureField":"héllo"} }';
+    terminal.send(frame);
+    expect(await response).toContain('"native-7"');
+    expect(received).toEqual([frame]);
+    expect(states.at(-1)).toMatchObject({ nativeThreadId: "native-7", state: "idle" });
+    const approval = new Promise<void>((resolve) => terminal.once("message", () => resolve()));
+    native!.send(
+      '{"id":99,"method":"item/commandExecution/requestApproval","params":{"threadId":"native-7","turnId":"turn-7"}}',
+    );
+    await approval;
+    expect(states.at(-1)?.state).toBe("waiting");
+    terminal.close();
+    await nativeClosed;
+    expect(received).toEqual([frame]);
+    expect(states.at(-1)?.state).toBe("unknown");
+    expect(errors).toEqual([]);
+    expect(http.listening).toBe(true);
+  } finally {
+    terminal.terminate();
+    await relay.close();
+    for (const peer of server.clients) peer.terminate();
+    server.close();
+    http.close();
+    await NodeFSP.rm(directory, { recursive: true, force: true });
+  }
+});
+
+it("allows an auxiliary picker connection without replacing the terminal identity", async () => {
+  const directory = await NodeFSP.mkdtemp("/tmp/t3-picker-test-");
+  const http = NodeHttp.createServer();
+  const server = new NodeWS.WebSocketServer({ server: http });
+  server.on("connection", (peer) =>
+    peer.on("message", (data) => {
+      const request = JSON.parse(data.toString());
+      peer.send(
+        JSON.stringify({
+          id: request.id,
+          result:
+            request.method === "thread/resume"
+              ? { thread: { id: request.params.threadId, status: { type: "idle" } } }
+              : { data: [] },
