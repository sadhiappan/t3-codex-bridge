+// @effect-diagnostics nodeBuiltinImport:off - Exercises benchmark behavior against actual Unix WebSocket peers.
+import * as NodeFSP from "node:fs/promises";
+import * as NodeHttp from "node:http";
+import { NodeWS } from "@effect/platform-node/NodeSocket";
+import { expect, it } from "vite-plus/test";
+import { benchmarkSharedCodex } from "./sharedCodexBenchmark.ts";
+
+it("measures direct and relayed reads without resuming sessions or retaining history", async () => {
+  const directory = await NodeFSP.mkdtemp("/tmp/t3-benchmark-");
+  const http = NodeHttp.createServer();
+  const server = new NodeWS.WebSocketServer({ server: http });
+  const methods: string[] = [];
+  server.on("connection", (peer) =>
+    peer.on("message", (data) => {
+      const request = JSON.parse(data.toString());
+      methods.push(request.method);
+      if (request.id !== undefined)
+        peer.send(
+          JSON.stringify({
+            id: request.id,
+            result:
+              request.method === "initialize"
+                ? {}
+                : { thread: { id: "test", secret: "private-transcript" } },
+          }),
+        );
+    }),
+  );
+  await new Promise<void>((resolve) => http.listen(directory + "/native.sock", resolve));
+  try {
+    const result = await benchmarkSharedCodex({
+      socketPath: directory + "/native.sock",
+      threadId: "test",
+      samples: 3,
+    });
+    expect(result.direct.samples).toBe(3);
+    expect(result.relayed.samples).toBe(3);
+    expect(result.direct.responseBytes).toBeGreaterThan(0);
+    expect(result.direct.p95Ms).toBeGreaterThanOrEqual(result.direct.p50Ms);
+    expect(methods.filter((method) => method === "thread/read")).toHaveLength(8);
+    expect(new Set(methods)).toEqual(new Set(["initialize", "initialized", "thread/read"]));
+    expect(JSON.stringify(result)).not.toContain("private-transcript");
+    expect(http.listening).toBe(true);
+  } finally {
+    for (const peer of server.clients) peer.terminate();
+    server.close();
+    http.close();
+    await NodeFSP.rm(directory, { recursive: true, force: true });
+  }
+});
+
+it("fails rather than publishing a successful report when connection fails", async () => {
+  await expect(
+    benchmarkSharedCodex({
+      socketPath: "/tmp/t3-benchmark-missing.sock",
+      threadId: "test",
+      samples: 1,
+    }),
+  ).rejects.toBeDefined();
+  await expect(
+    benchmarkSharedCodex({ socketPath: "/tmp/unused", threadId: "test", samples: 0 }),
+  ).rejects.toThrow("samples");
+});
diff --git a/apps/server/src/provider/sharedCodexBenchmark.ts b/apps/server/src/provider/sharedCodexBenchmark.ts
new file mode 100644
index 000000000..47f2daec4
--- /dev/null
+++ b/apps/server/src/provider/sharedCodexBenchmark.ts
@@ -0,0 +1,91 @@
+// @effect-diagnostics nodeBuiltinImport:off - Maintainer benchmark uses a monotonic high-resolution clock.
+import * as NodePerfHooks from "node:perf_hooks";
+import * as Effect from "effect/Effect";
+import * as Schema from "effect/Schema";
+import * as Layer from "effect/Layer";
+import * as CodexClient from "effect-codex-app-server/client";
+import { makeSharedCodexTransport } from "./Layers/codexSharedTransport.ts";
+import { startTerminalRelay } from "./sharedCodexTerminalRelay.ts";
+
+const encodeJson = Schema.encodeEffect(Schema.fromJsonString(Schema.Unknown));
+
+export async function benchmarkSharedCodex(options: {
+  socketPath: string;
+  threadId: string;
+  samples: number;
+}) {
+  if (!Number.isInteger(options.samples) || options.samples < 1 || options.samples > 200)
+    throw new Error("Benchmark samples must be an integer between 1 and 200");
+  if (!options.threadId) throw new Error("An explicit benchmark thread is required");
+  const measure = (socketPath: string) =>
+    Effect.runPromise(
+      Effect.scoped(
+        Effect.gen(function* () {
+          const started = NodePerfHooks.performance.now();
+          const transport = yield* makeSharedCodexTransport(socketPath);
+          const context = yield* Layer.build(
+            CodexClient.layerStdio(transport.stdio, {}, transport.terminationError),
+          );
+          const client = yield* CodexClient.CodexAppServerClient.pipe(Effect.provide(context));
+          yield* client.raw.request("initialize", {
+            clientInfo: { name: "t3_shared_benchmark", version: "0.1.0" },
+            capabilities: { experimentalApi: true },
+          });
+          yield* client.raw.notify("initialized");
+          const initializeMs = NodePerfHooks.performance.now() - started;
+          const timings: number[] = [];
+          let responseBytes = 0;
+          for (let index = 0; index < options.samples + 1; index += 1) {
+            const before = NodePerfHooks.performance.now();
+            const response = yield* client.raw.request("thread/read", {
+              threadId: options.threadId,
+              includeTurns: true,
+            });
+            const elapsed = NodePerfHooks.performance.now() - before;
+            if (index === 0) {
+              responseBytes = Buffer.byteLength(yield* encodeJson(response));
+              continue;
+            }
+            timings.push(elapsed);
+          }
+          timings.sort((a, b) => a - b);
+          return {
+            initializeMs,
+            samples: timings.length,
+            responseBytes,
+            p50Ms: timings[Math.ceil(timings.length * 0.5) - 1]!,
+            p95Ms: timings[Math.ceil(timings.length * 0.95) - 1]!,
+            maxMs: timings.at(-1)!,
+          };
+        }),
+      ).pipe(Effect.timeout("60 seconds")),
+    );
+  const direct = await measure(options.socketPath);
+  const errors: string[] = [];
+  const relay = await startTerminalRelay({
+    upstreamSocket: options.socketPath,
+    onState: () => {},
+    onError: (error) => errors.push(error.message),
+  });
+  try {
+    const relayed = await measure(relay.socketPath);
+    if (errors.length) throw new Error(`Relay benchmark failed: ${errors.join("; ")}`);
+    return {
+      measurement:
+        "Sequential warm native thread/read including history; one warm-up excluded. No model turn or phone-network measurement.",
+      direct,
+      relayed,
+    };
+  } finally {
+    await relay.close();
+  }
+}
+
+if (import.meta.main) {
+  const result = await benchmarkSharedCodex({
+    socketPath: process.env.T3_CODEX_SHARED_SOCKET ?? "",
+    threadId: process.env.T3_CODEX_BENCHMARK_THREAD ?? "",
+    samples: Number(process.env.T3_CODEX_BENCHMARK_SAMPLES ?? "30"),
+  });
+  process.stdout.write(JSON.stringify(result, null, 2) + "\n");
+}
