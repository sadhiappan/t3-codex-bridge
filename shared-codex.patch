@@ -0,0 +1,69 @@
+// @effect-diagnostics nodeBuiltinImport:off - exercises a real Unix WebSocket peer.
+import * as NodeHttp from "node:http";
+import * as NodeFSP from "node:fs/promises";
+import * as NodeOS from "node:os";
+import * as NodePath from "node:path";
+
+import { NodeWS } from "@effect/platform-node/NodeSocket";
+import * as Effect from "effect/Effect";
+import * as Layer from "effect/Layer";
+import * as CodexClient from "effect-codex-app-server/client";
+import { describe, expect } from "vite-plus/test";
+import { it } from "@effect/vitest";
+
+import { makeSharedCodexTransport } from "./codexSharedTransport.ts";
+
+describe("shared Codex socket", () => {
+  it.effect("preserves message boundaries and uses text frames without compression", () =>
+    Effect.gen(function* () {
+      const dir = yield* Effect.promise(() =>
+        NodeFSP.mkdtemp(NodePath.join(NodeOS.tmpdir(), "codex-ws-")),
+      );
+      const socketPath = NodePath.join(dir, "rpc.sock");
+      const http = NodeHttp.createServer();
+      const server = new NodeWS.WebSocketServer({ server: http });
+      let compression: string | undefined;
+      let binaryFrame = false;
+      server.on("connection", (socket, request) => {
+        compression = request.headers["sec-websocket-extensions"];
+        socket.on("message", (data, binary) => {
+          binaryFrame ||= binary;
+          const message = JSON.parse(data.toString());
+          socket.send(JSON.stringify({ method: "test/notice", params: { text: "one\ntwo" } }));
+          socket.send(JSON.stringify({ id: message.id, result: { text: "héllo\nworld" } }));
+        });
+      });
+      yield* Effect.promise(() => new Promise<void>((resolve) => http.listen(socketPath, resolve)));
+      try {
+        const result = yield* Effect.scoped(
+          Effect.gen(function* () {
+            const transport = yield* makeSharedCodexTransport(socketPath);
+            const context = yield* Layer.build(
+              CodexClient.layerStdio(transport.stdio, {}, transport.terminationError),
+            );
+            const client = yield* CodexClient.CodexAppServerClient.pipe(Effect.provide(context));
+            return yield* client.raw.request("test/echo", { text: "hello" });
+          }),
+        );
+        expect(result).toEqual({ text: "héllo\nworld" });
+        expect(compression).toBeUndefined();
+        expect(binaryFrame).toBe(false);
+        expect(http.listening).toBe(true);
+      } finally {
+        for (const socket of server.clients) socket.terminate();
+        server.close();
+        http.close();
+        yield* Effect.promise(() => NodeFSP.rm(dir, { recursive: true, force: true }));
+      }
+    }),
+  );
+
+  it.effect("reports a missing socket without starting a process", () =>
+    Effect.gen(function* () {
+      const error = yield* Effect.scoped(makeSharedCodexTransport("/nonexistent/codex.sock")).pipe(
+        Effect.flip,
+      );
+      expect(error.message).toContain("connect-shared-socket");
+    }),
+  );
+});
diff --git a/apps/server/src/provider/Layers/codexSharedTransport.ts b/apps/server/src/provider/Layers/codexSharedTransport.ts
new file mode 100644
index 000000000..f05c1c6b3
--- /dev/null
+++ b/apps/server/src/provider/Layers/codexSharedTransport.ts
@@ -0,0 +1,93 @@
+import * as NodeStream from "node:stream";
+
+import { NodeWS } from "@effect/platform-node/NodeSocket";
+import * as EffectNodeStream from "@effect/platform-node/NodeStream";
+import * as Effect from "effect/Effect";
+import * as PlatformError from "effect/PlatformError";
+import * as Sink from "effect/Sink";
+import * as Stdio from "effect/Stdio";
+import * as CodexErrors from "effect-codex-app-server/errors";
+
+export const makeSharedCodexTransport = Effect.fn("makeSharedCodexTransport")(function* (
+  socketPath: string,
+) {
+  const connectError = (cause: unknown) =>
+    new CodexErrors.CodexAppServerTransportError({
+      operation: "connect-shared-socket",
+      cause,
+    });
+  if (!socketPath.startsWith("/") || /[:?#]/.test(socketPath)) {
+    return yield* connectError(
+      new Error("Expected an absolute Unix socket path without URL delimiters."),
+    );
+  }
+  const socket = yield* Effect.acquireRelease(
+    Effect.try({
+      try: () =>
+        new NodeWS.WebSocket(`ws+unix://${socketPath}:/`, {
+          // Codex's Unix listener rejects the compression extension offered by ws by default.
+          perMessageDeflate: false,
+          handshakeTimeout: 5000,
+        }),
+      catch: connectError,
+    }),
+    (socket) => Effect.sync(() => socket.terminate()),
+  );
+  const input = new NodeStream.Readable({ read: () => socket.resume() });
+  const terminated = new Promise<CodexErrors.CodexAppServerError>((resolve) => {
+    socket.on("error", (cause) => {
+      resolve(
+        new CodexErrors.CodexAppServerTransportError({ operation: "read-input-stream", cause }),
+      );
+      input.push(null);
+    });
+    socket.on("close", () => {
+      resolve(new CodexErrors.CodexAppServerInputStreamEndedError({}));
+      input.push(null);
+    });
+  });
+  socket.on("message", (data, binary) => {
+    if (binary) {
+      socket.close(1003, "Expected JSON text frames");
+      return;
+    }
+    if (!input.push(Buffer.from(`${data.toString()}\n`))) socket.pause();
+  });
+  yield* Effect.tryPromise({
+    try: () =>
+      new Promise<void>((resolve, reject) => {
+        socket.once("open", resolve);
+        socket.once("error", reject);
+      }),
+    catch: connectError,
+  });
+  const ioError = (cause: unknown) =>
+    PlatformError.systemError({
+      _tag: "Unknown",
+      module: "CodexSharedSocket",
+      method: "io",
+      cause,
+    });
+  return {
+    terminationError: Effect.promise(() => terminated),
+    stdio: Stdio.make({
+      args: Effect.succeed([]),
+      stdin: EffectNodeStream.fromReadable({ evaluate: () => input, onError: ioError }),
+      stdout: () =>
+        Sink.forEach((chunk: string | Uint8Array) =>
+          Effect.tryPromise({
+            try: () =>
+              new Promise<void>((resolve, reject) =>
+                socket.send(
+                  typeof chunk === "string" ? chunk : Buffer.from(chunk).toString("utf8"),
+                  { binary: false },
+                  (error) => (error ? reject(error) : resolve()),
+                ),
+              ),
+            catch: ioError,
+          }),
+        ),
+      stderr: () => Sink.drain,
+    }),
+  };
+});
