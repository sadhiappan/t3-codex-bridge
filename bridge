#!/usr/bin/env bash
set -euo pipefail
BRIDGE_SOURCE="${BASH_SOURCE[0]}"
[[ "$BRIDGE_SOURCE" = /* ]] || BRIDGE_SOURCE="$PWD/$BRIDGE_SOURCE"
while [[ -L "$BRIDGE_SOURCE" ]]; do
  BRIDGE_DIRECTORY="$(cd -- "$(dirname -- "$BRIDGE_SOURCE")" && pwd -P)"
  BRIDGE_SOURCE="$(readlink "$BRIDGE_SOURCE")"
  [[ "$BRIDGE_SOURCE" = /* ]] || BRIDGE_SOURCE="$BRIDGE_DIRECTORY/$BRIDGE_SOURCE"
done
ROOT="$(cd -- "$(dirname -- "$BRIDGE_SOURCE")" && pwd -P)"
if [[ ! -x "$ROOT/bin/bridge" ]]; then
  echo "Build the native CLI first: ./scripts/build-go.sh (or download a prebuilt bundle)." >&2
  exit 1
fi
exec "$ROOT/bin/bridge" "$@"
